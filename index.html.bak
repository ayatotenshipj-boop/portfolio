<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#05060a">
<meta name="description" content="Ayato — Security Researcher. Segurança ofensiva, pentesting e ferramentas próprias.">
<title>Ayato — Security Researcher</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Sora:wght@200;300;400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ════════════════════════════════════════════
   TOKENS
════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  /* the character's world: ink + porcelain + cobalt halo */
  --ink:        #05060a;
  --ink-2:      #0a0c14;
  --surface:    #0e111c;
  --surface-2:  #141826;
  --line:       rgba(120,150,210,.10);
  --line-2:     rgba(120,150,210,.18);

  --cobalt:     #2f6bff;   /* electric hair blue */
  --cobalt-lo:  #1c3a82;
  --ice:        #6fd0ff;   /* the cyan eye-glow */
  --halo:       #7ea2ff;   /* the broken halo */
  --rose:       #3d7bff;   /* blue rose core */
  --rose-glow:  #5e9bff;

  --paper:      #eef1f8;   /* porcelain near-white */
  --fg:         #d6dcea;
  --fg-dim:     #79839e;
  --fg-faint:   #475069;

  --f-display:  'Syne', sans-serif;
  --f-body:     'Sora', sans-serif;
  --f-mono:     'JetBrains Mono', monospace;

  --spring: cubic-bezier(.16,1,.3,1);
  --out:    cubic-bezier(.25,0,0,1);

  /* fluid scale — everything bends to viewport */
  --gut: clamp(1.25rem, 5vw, 5.5rem);
}

html{font-size:16px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}}

body{
  background:var(--ink);
  color:var(--fg);
  font-family:var(--f-body);
  font-weight:300;
  line-height:1.7;
  overflow-x:hidden;
}
body.touch{cursor:auto}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
::selection{background:var(--cobalt);color:#fff}

/* faint grain / vignette over the whole page so it reads like the ink artwork */
body::before{
  content:'';position:fixed;inset:0;z-index:1;pointer-events:none;
  background:
    radial-gradient(120% 80% at 80% 0%, rgba(47,107,255,.06), transparent 55%),
    radial-gradient(80% 60% at 0% 100%, rgba(111,208,255,.05), transparent 60%);
}

/* ════════════════════════════════════════════
   CURSOR (pointer devices only)
════════════════════════════════════════════ */
#cur,#cur-r{position:fixed;top:0;left:0;border-radius:50%;pointer-events:none;z-index:9999;will-change:transform;opacity:0;transition:opacity .4s}
#cur{width:6px;height:6px;background:var(--ice);transform:translate(-50%,-50%);mix-blend-mode:screen}
#cur-r{width:30px;height:30px;border:1px solid rgba(126,162,255,.5);transform:translate(-50%,-50%)}
body.touch #cur,body.touch #cur-r{display:none}

/* ════════════════════════════════════════════
   REVEAL
════════════════════════════════════════════ */
.rv{opacity:0;transform:translateY(26px);transition:opacity .9s var(--spring),transform .9s var(--spring)}
.rv.in{opacity:1;transform:none}
.rv-l{opacity:0;transform:translateX(-36px);transition:opacity .9s var(--spring),transform .9s var(--spring)}
.rv-l.in{opacity:1;transform:none}
.rv-r{opacity:0;transform:translateX(36px);transition:opacity .9s var(--spring),transform .9s var(--spring)}
.rv-r.in{opacity:1;transform:none}

/* ════════════════════════════════════════════
   NAV
════════════════════════════════════════════ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:clamp(.9rem,2.2vw,1.4rem) var(--gut);
  padding-top:max(clamp(.9rem,2.2vw,1.4rem),env(safe-area-inset-top));
  transition:background .6s var(--out),padding .6s var(--out),border-color .6s;
  border-bottom:1px solid transparent;
}
nav.scrolled{
  background:rgba(5,6,10,.72);
  backdrop-filter:blur(22px) saturate(160%);
  -webkit-backdrop-filter:blur(22px) saturate(160%);
  border-bottom-color:var(--line);
  padding-top:clamp(.55rem,1.4vw,.9rem);
  padding-bottom:clamp(.55rem,1.4vw,.9rem);
}
.logo{display:flex;align-items:center;gap:.7rem;font-family:var(--f-display);font-weight:700;font-size:clamp(.85rem,1.1vw,1rem);letter-spacing:.04em}
.logo-img{width:38px;height:38px;border-radius:50%;overflow:hidden;border:1.5px solid var(--cobalt-lo);flex-shrink:0;position:relative;transition:border-color .4s}
.logo-img img{width:100%;height:100%;object-fit:cover;object-position:center top}
.logo:hover .logo-img{border-color:var(--ice)}
.logo b{font-weight:700}.logo b span{color:var(--ice)}

.nav-links{display:flex;gap:clamp(1.2rem,2.4vw,2.4rem);list-style:none;font-family:var(--f-mono);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase}
.nav-links a{color:var(--fg-dim);position:relative;padding:.3rem 0;transition:color .35s}
.nav-links a::after{content:'';position:absolute;left:0;bottom:-2px;width:0;height:1px;background:var(--ice);transition:width .4s var(--spring)}
.nav-links a:hover{color:var(--paper)}.nav-links a:hover::after{width:100%}

.status{display:flex;align-items:center;gap:.5rem;font-family:var(--f-mono);font-size:.66rem;color:var(--fg-dim);letter-spacing:.06em}
.dot{width:6px;height:6px;border-radius:50%;background:#43e08a;animation:pulse 2.4s ease infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(67,224,138,.45)}50%{box-shadow:0 0 0 5px rgba(67,224,138,0)}}

/* hamburger */
.burger{display:none;flex-direction:column;gap:5px;width:26px;background:none;border:0;cursor:pointer;padding:4px;z-index:101}
.burger span{display:block;height:1.5px;width:100%;background:var(--paper);transition:.35s var(--spring);transform-origin:center}
.burger.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}

/* ════════════════════════════════════════════
   HERO
════════════════════════════════════════════ */
.hero{position:relative;width:100%;min-height:100svh;min-height:100dvh;display:flex;align-items:flex-end;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;object-position:72% 18%;transform:scale(1.06);animation:heroIn 1.9s var(--spring) forwards;will-change:transform}
@keyframes heroIn{from{transform:scale(1.13);filter:brightness(.55) saturate(.8)}to{transform:scale(1.04);filter:brightness(.92) saturate(1)}}
.hero-bg::after{
  content:'';position:absolute;inset:0;
  background:
    linear-gradient(105deg, rgba(5,6,10,.95) 0%, rgba(5,6,10,.72) 38%, rgba(5,6,10,.18) 66%, transparent 100%),
    linear-gradient(0deg, rgba(5,6,10,.98) 0%, rgba(5,6,10,.45) 26%, transparent 56%);
}

.hero-content{position:relative;z-index:3;padding:0 var(--gut) clamp(4rem,9vh,7rem);max-width:min(640px,90vw)}
.eyebrow{font-family:var(--f-mono);font-size:clamp(.65rem,1.4vw,.74rem);letter-spacing:.2em;text-transform:uppercase;color:var(--ice);margin-bottom:1.2rem;display:flex;align-items:center;gap:.7rem;opacity:0;animation:fadeUp .7s .4s var(--spring) forwards}
.eyebrow::before{content:'';width:26px;height:1px;background:var(--ice)}
.hero h1{font-family:var(--f-display);font-weight:800;font-size:clamp(2.6rem,9vw,5.4rem);line-height:.98;letter-spacing:-.035em;color:var(--paper);margin-bottom:1.4rem;opacity:0;animation:fadeUp .8s .55s var(--spring) forwards}
.hero h1 .accent{color:var(--ice);display:block}
.hero-sub{font-size:clamp(.95rem,2.2vw,1.05rem);font-weight:200;color:var(--fg-dim);max-width:42ch;margin-bottom:2.4rem;opacity:0;animation:fadeUp .8s .7s var(--spring) forwards}
.hero-cta{display:flex;gap:.9rem;flex-wrap:wrap;opacity:0;animation:fadeUp .8s .85s var(--spring) forwards}
@keyframes fadeUp{to{opacity:1;transform:none}}

/* shard fragments drifting off the hero — echoes the artwork */
.shards{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden}
.shard{position:absolute;background:linear-gradient(135deg,var(--ice),var(--cobalt));opacity:0;animation:shardFloat 9s ease-in-out infinite}
.shard:nth-child(1){width:14px;height:4px;top:30%;right:18%;transform:rotate(28deg);animation-delay:1.2s}
.shard:nth-child(2){width:9px;height:3px;top:46%;right:9%;transform:rotate(-15deg);animation-delay:2.4s}
.shard:nth-child(3){width:18px;height:3px;top:62%;right:24%;transform:rotate(42deg);animation-delay:.6s}
.shard:nth-child(4){width:7px;height:7px;top:38%;right:30%;border-radius:50%;animation-delay:3.1s}
@keyframes shardFloat{0%,100%{opacity:0;transform:translate(0,0) rotate(0)}40%{opacity:.7}50%{transform:translate(14px,-10px) rotate(20deg)}}

/* buttons */
.btn{position:relative;display:inline-flex;align-items:center;gap:.5rem;font-family:var(--f-mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;padding:.9rem 1.7rem;border-radius:4px;overflow:hidden;transition:transform .4s var(--spring),box-shadow .4s var(--out);will-change:transform}
.btn span{position:relative;z-index:1}
.btn::before{content:'';position:absolute;inset:0;background:var(--paper);transform:translateX(-101%);transition:transform .4s var(--spring);z-index:0}
.btn-1{background:var(--cobalt);color:#fff;font-weight:500}
.btn-1::before{background:var(--ice)}
.btn-1 span{color:var(--ink)}
.btn-1:hover{transform:translateY(-3px);box-shadow:0 10px 34px rgba(47,107,255,.34)}
.btn-1:hover::before{transform:translateX(0)}
.btn-2{background:transparent;color:var(--fg-dim);border:1px solid var(--line-2)}
.btn-2::before{background:rgba(120,150,210,.07);transform:scaleX(0);transform-origin:left;transition:transform .4s var(--spring)}
.btn-2:hover{color:var(--paper);border-color:var(--line-2);transform:translateY(-3px)}
.btn-2:hover::before{transform:scaleX(1)}

.hero-scroll{position:absolute;bottom:2.2rem;right:var(--gut);z-index:3;display:flex;flex-direction:column;align-items:center;gap:.5rem;opacity:0;animation:fadeIn .8s 1.2s var(--out) forwards}
@keyframes fadeIn{to{opacity:.5}}
.scroll-line{width:1px;height:46px;background:linear-gradient(transparent,var(--ice));animation:scrollAnim 2s ease infinite}
@keyframes scrollAnim{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.scroll-label{font-family:var(--f-mono);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--fg-dim);writing-mode:vertical-rl}

/* ════════════════════════════════════════════
   SECTION SHELL
════════════════════════════════════════════ */
section{padding:clamp(4.5rem,11vh,8rem) var(--gut);position:relative;z-index:2}
.label{font-family:var(--f-mono);font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ice);margin-bottom:.8rem;display:flex;align-items:center;gap:.7rem}
.label::before{content:'';width:18px;height:1px;background:var(--ice)}
.title{font-family:var(--f-display);font-weight:700;font-size:clamp(1.9rem,5.5vw,3.1rem);line-height:1.05;letter-spacing:-.025em;color:var(--paper)}

/* ════════════════════════════════════════════
   BLUE ROSE DIVIDER — the signature
════════════════════════════════════════════ */
.rose-sep{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:clamp(3rem,8vh,5rem) var(--gut);position:relative;z-index:2}
.rose{width:clamp(90px,16vw,140px);height:auto;overflow:visible}
.rose path,.rose line,.rose circle{fill:none;stroke:var(--halo);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:var(--len);stroke-dashoffset:var(--len);}
.rose-sep.in .rose path,.rose-sep.in .rose line,.rose-sep.in .rose circle{animation:draw 2.2s var(--out) forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.rose .petal-fill{fill:rgba(47,107,255,.07);stroke:none;opacity:0}
.rose-sep.in .rose .petal-fill{animation:fillIn 1.4s 1.4s ease forwards}
@keyframes fillIn{to{opacity:1}}
.rose-glow{filter:drop-shadow(0 0 6px rgba(94,155,255,.5)) drop-shadow(0 0 18px rgba(47,107,255,.25))}
.rose-cap{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.28em;text-transform:uppercase;color:var(--fg-faint);margin-top:1.3rem;opacity:0;transition:opacity 1s 1.8s}
.rose-sep.in .rose-cap{opacity:1}

/* drifting petals around the rose */
.petal{position:absolute;width:7px;height:9px;background:linear-gradient(160deg,var(--rose-glow),var(--cobalt-lo));border-radius:60% 0 60% 0;opacity:0;pointer-events:none}
.rose-sep.in .petal{animation:petalDrift 6s ease-in infinite}
.petal:nth-child(1){top:30%;left:30%;animation-delay:2s!important}
.petal:nth-child(2){top:36%;right:32%;animation-delay:3.4s!important}
.petal:nth-child(3){top:24%;left:42%;animation-delay:4.6s!important}
@keyframes petalDrift{0%{opacity:0;transform:translate(0,0) rotate(0)}20%{opacity:.8}100%{opacity:0;transform:translate(-22px,70px) rotate(120deg)}}

/* simple line divider variant */
.halo-sep{display:flex;justify-content:center;padding:clamp(2rem,5vh,3.2rem) 0;position:relative;z-index:2}
.halo-ring{width:clamp(120px,30vw,220px);height:34px;border:1px solid var(--line-2);border-radius:50%;transform:perspective(200px) rotateX(62deg);box-shadow:0 0 24px rgba(126,162,255,.12)}

/* ════════════════════════════════════════════
   ABOUT
════════════════════════════════════════════ */
.about-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,5vw,4.5rem);align-items:center;max-width:1200px;margin:0 auto}
.pfp-wrap{position:relative;width:100%;max-width:340px;margin:0 auto;aspect-ratio:3/4}
.pfp-wrap img{width:100%;height:100%;object-fit:cover;border-radius:14px;border:1px solid var(--line-2);position:relative;z-index:2}
.pfp-halo{position:absolute;top:-22px;left:50%;transform:translateX(-50%) perspective(300px) rotateX(60deg);width:62%;height:54px;border:1.5px solid var(--halo);border-radius:50%;z-index:1;box-shadow:0 0 30px rgba(126,162,255,.4);animation:haloFloat 5s ease-in-out infinite}
@keyframes haloFloat{0%,100%{transform:translateX(-50%) perspective(300px) rotateX(60deg) translateY(0)}50%{transform:translateX(-50%) perspective(300px) rotateX(60deg) translateY(-7px)}}
.pfp-glow{position:absolute;inset:-1px;border-radius:14px;background:linear-gradient(135deg,rgba(47,107,255,.35),transparent 60%);z-index:1;filter:blur(14px)}
.stats{display:flex;gap:.7rem;margin-top:1.2rem;flex-wrap:wrap}
.chip{flex:1;min-width:120px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:.8rem 1rem;font-family:var(--f-mono);font-size:.66rem;color:var(--fg-dim);letter-spacing:.04em;text-align:center}
.chip strong{display:block;font-family:var(--f-display);font-size:1.5rem;color:var(--ice);font-weight:700;margin-bottom:.1rem}

.about-text p{color:var(--fg-dim);margin:1.1rem 0;font-size:clamp(.92rem,2vw,1rem)}
.about-text .title{margin-bottom:.5rem}
.about-text strong{color:var(--paper);font-weight:400}
.tags{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.6rem}
.tag{font-family:var(--f-mono);font-size:.66rem;padding:.32rem .7rem;border-radius:5px;background:rgba(120,150,210,.05);border:1px solid var(--line);color:var(--fg-dim);transition:.3s var(--spring)}
.tag:hover{border-color:var(--ice);color:var(--ice);transform:translateY(-2px)}

/* ════════════════════════════════════════════
   SKILLS
════════════════════════════════════════════ */
.skills{position:relative;overflow:hidden}
.skills-bg{position:absolute;inset:0;z-index:0;opacity:.07}
.skills-bg img{width:100%;height:100%;object-fit:cover;object-position:center}
.skills-inner{position:relative;z-index:2;max-width:1200px;margin:0 auto}
.skills-head{margin-bottom:clamp(2.4rem,5vw,3.4rem)}
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:clamp(.9rem,1.8vw,1.2rem)}
.scard{background:linear-gradient(160deg,var(--surface),var(--ink-2));border:1px solid var(--line);border-radius:14px;padding:clamp(1.3rem,2.4vw,1.7rem);position:relative;overflow:hidden;transition:transform .4s var(--spring),border-color .4s}
.scard::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--cobalt),transparent);transform:scaleX(0);transform-origin:left;transition:transform .5s var(--spring)}
.scard:hover{transform:translateY(-5px);border-color:var(--line-2)}
.scard:hover::before{transform:scaleX(1)}
.sicon{font-size:1.4rem;margin-bottom:.7rem;display:block}
.sname{font-family:var(--f-display);font-weight:600;font-size:1.02rem;color:var(--paper);margin-bottom:.45rem}
.sdesc{font-size:.82rem;color:var(--fg-dim);line-height:1.6}
.smeta{margin-top:1rem;display:flex;align-items:center;gap:.55rem;font-family:var(--f-mono);font-size:.6rem;letter-spacing:.08em;color:var(--fg-faint);text-transform:uppercase}
.sdots{display:flex;gap:3px}
.sdots i{width:6px;height:6px;border-radius:50%;background:var(--line-2);display:block}
.sdots i.on{background:var(--ice);box-shadow:0 0 5px var(--ice)}

/* ════════════════════════════════════════════
   PROJECTS
════════════════════════════════════════════ */
.proj-head{margin-bottom:clamp(2.4rem,5vw,3.4rem)}
.proj-list{display:flex;flex-direction:column;gap:clamp(.8rem,1.6vw,1rem);max-width:1100px;margin:0 auto}
.pcard{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:clamp(1.3rem,2.6vw,1.8rem) clamp(1.4rem,3vw,2.1rem);position:relative;overflow:hidden;transition:transform .4s var(--spring),border-color .4s,background .4s}
.pcard::after{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--cobalt);transform:scaleY(0);transform-origin:top;transition:transform .45s var(--spring)}
.pcard:hover{transform:translateX(6px);border-color:var(--line-2);background:var(--surface-2)}
.pcard:hover::after{transform:scaleY(1)}
.pmeta{display:flex;align-items:center;gap:.8rem;margin-bottom:.6rem}
.pnum{font-family:var(--f-mono);font-size:.72rem;color:var(--ice);letter-spacing:.05em}
.ptag{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-dim);padding:.2rem .55rem;border:1px solid var(--line);border-radius:4px}
.pname{font-family:var(--f-display);font-weight:700;font-size:clamp(1.1rem,2.6vw,1.35rem);color:var(--paper);margin-bottom:.4rem}
.pdesc{font-size:.85rem;color:var(--fg-dim);max-width:60ch;line-height:1.6}
.pstack{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.85rem}
.pill{font-family:var(--f-mono);font-size:.6rem;padding:.22rem .5rem;border-radius:4px;background:rgba(47,107,255,.08);color:var(--halo);border:1px solid rgba(47,107,255,.16)}
.parrow{font-size:1.3rem;color:var(--fg-faint);transition:.4s var(--spring)}
.pcard:hover .parrow{color:var(--ice);transform:translateX(4px)}

/* ════════════════════════════════════════════
   CONTACT
════════════════════════════════════════════ */
.contact{text-align:center;position:relative;overflow:hidden}
.contact::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(560px,90vw);height:min(560px,90vw);background:radial-gradient(circle,rgba(47,107,255,.1),transparent 65%);z-index:0}
.contact-inner{position:relative;z-index:2;max-width:680px;margin:0 auto}
.contact .label{justify-content:center}
.contact .title{margin-bottom:1.1rem}
.contact-sub{color:var(--fg-dim);margin-bottom:2.2rem;font-size:clamp(.92rem,2vw,1.02rem);max-width:46ch;margin-left:auto;margin-right:auto}
.contact-links{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap;margin-top:2.2rem}
.clink{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--f-mono);font-size:.7rem;letter-spacing:.05em;color:var(--fg-dim);padding:.7rem 1.2rem;border:1px solid var(--line);border-radius:6px;transition:.35s var(--spring)}
.clink:hover{color:var(--paper);border-color:var(--ice);transform:translateY(-3px)}
.clink svg{flex-shrink:0}

/* ════════════════════════════════════════════
   FOOTER
════════════════════════════════════════════ */
footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.6rem var(--gut);padding-bottom:max(1.6rem,env(safe-area-inset-bottom));border-top:1px solid var(--line);font-family:var(--f-mono);font-size:.64rem;color:var(--fg-faint);letter-spacing:.04em;position:relative;z-index:2;flex-wrap:wrap}
footer span b{color:var(--fg-dim);font-weight:400}

/* ════════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════════ */
@media (max-width:880px){
  .about-grid{grid-template-columns:1fr;gap:2.6rem}
  .pfp-wrap{max-width:280px}
}
@media (max-width:720px){
  body{cursor:auto}
  .nav-links,.status{display:none}
  .burger{display:flex}
  /* mobile drawer */
  .nav-drawer{position:fixed;inset:0;z-index:99;background:rgba(5,6,10,.97);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.8rem;opacity:0;visibility:hidden;transition:opacity .4s var(--out),visibility .4s}
  .nav-drawer.open{opacity:1;visibility:visible}
  .nav-drawer a{font-family:var(--f-display);font-weight:700;font-size:1.7rem;color:var(--paper);letter-spacing:-.01em}
  .nav-drawer .dstatus{font-family:var(--f-mono);font-size:.7rem;color:var(--ice);letter-spacing:.1em;margin-top:1rem;display:flex;align-items:center;gap:.5rem}
  .hero-scroll{display:none}
  .hero-bg img{object-position:68% 16%}
  .pcard{grid-template-columns:1fr}
  .parrow{display:none}
  .pdesc{max-width:100%}
  .stats .chip{min-width:0}
}
@media (max-width:420px){
  .hero h1{font-size:clamp(2.2rem,11vw,3rem)}
  .chip{flex:1 1 100%}
  .contact-links{flex-direction:column;align-items:center}
  .clink{width:100%;max-width:260px;justify-content:center}
  footer{flex-direction:column;text-align:center;gap:.5rem}
}
.nav-drawer{display:none}
@media (max-width:720px){.nav-drawer{display:flex}}

/* logo-img como link para GitHub */
a.logo-img{display:block;border-radius:50%;overflow:hidden;border:1.5px solid var(--cobalt-lo);flex-shrink:0;position:relative;transition:border-color .4s;width:38px;height:38px;}
.logo:hover a.logo-img{border-color:var(--ice)}
a.logo-img img{width:100%;height:100%;object-fit:cover;object-position:center top;}

@media (max-width:480px){
  .hero h1{font-size:clamp(1.9rem,10vw,2.8rem)}
}
</style>
</head>
<body>

<div id="cur"></div><div id="cur-r"></div>

<!-- NAV -->
<nav id="nav">
  <a class="logo" href="#home">
    <a class="logo-img" href="https://github.com/ayatotenshipj-boop" target="_blank" rel="noopener" aria-label="Perfil no GitHub"><img src="data:image/jpeg;base64," alt="Ayato" loading="lazy"></a>
    <b>Ayato<span>_TENSHI</span></b>
  </a>
  <ul class="nav-links">
    <li><a href="#about">Sobre</a></li>
    <li><a href="#skills">Skills</a></li>
    <li><a href="#projects">Projetos</a></li>
    <li><a href="#contact">Contato</a></li>
  </ul>
  <div class="status"><span class="dot"></span><span>Disponível</span></div>
  <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

<div class="nav-drawer" id="drawer">
  <a href="#about">Sobre</a>
  <a href="#skills">Skills</a>
  <a href="#projects">Projetos</a>
  <a href="#contact">Contato</a>
  <div class="dstatus"><span class="dot"></span>Disponível para colaborações</div>
</div>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-bg"><img src="data:image/jpeg;base64," alt="" draggable="false"></div>
  <div class="shards"><i class="shard"></i><i class="shard"></i><i class="shard"></i><i class="shard"></i></div>
  <div class="hero-content">
    <div class="eyebrow">Security Researcher</div>
    <h1>Desmontando sistemas,<span class="accent">construindo defesas.</span></h1>
    <p class="hero-sub">Segurança ofensiva, pentesting e ferramentas próprias. Aprendo desmontando o que os outros confiam que vai funcionar.</p>
    <div class="hero-cta">
      <a href="#projects" class="btn btn-1"><span>Ver projetos</span></a>
      <a href="#contact" class="btn btn-2"><span>Falar comigo</span></a>
    </div>
  </div>
  <div class="hero-scroll"><div class="scroll-line"></div><span class="scroll-label">scroll</span></div>
</section>

<!-- BLUE ROSE — signature -->
<div class="rose-sep" id="rose">
  <i class="petal"></i><i class="petal"></i><i class="petal"></i>
  <svg class="rose rose-glow" viewBox="0 0 120 150" aria-hidden="true">
    <!-- stem -->
    <path d="M60 92 C60 110 60 124 60 144" style="--len:60"/>
    <!-- leaves — simétricas em relação ao caule -->
    <path class="petal-fill" d="M60 118 C48 112 38 118 36 128 C48 130 58 126 60 118Z"/>
    <path d="M60 118 C48 112 38 118 36 128 C48 130 58 126 60 118Z" style="--len:62"/>
    <path class="petal-fill" d="M60 118 C72 112 82 118 84 128 C72 130 62 126 60 118Z"/>
    <path d="M60 118 C72 112 82 118 84 128 C72 130 62 126 60 118Z" style="--len:62"/>
    <!-- outer bloom petals — simetria perfeita -->
    <path class="petal-fill" d="M60 92 C36 90 22 70 30 48 C44 38 60 52 60 70Z"/>
    <path d="M60 92 C36 90 22 70 30 48 C44 38 60 52 60 70Z" style="--len:120"/>
    <path class="petal-fill" d="M60 92 C84 90 98 70 90 48 C76 38 60 52 60 70Z"/>
    <path d="M60 92 C84 90 98 70 90 48 C76 38 60 52 60 70Z" style="--len:120"/>
    <!-- inner petals — espelhadas simetricamente -->
    <path class="petal-fill" d="M60 88 C44 78 40 56 56 42 C70 34 80 50 74 66Z"/>
    <path d="M60 88 C44 78 40 56 56 42 C70 34 80 50 74 66Z" style="--len:110"/>
    <path class="petal-fill" d="M60 88 C76 78 80 56 64 42 C50 34 40 50 46 66Z"/>
    <path d="M60 88 C76 78 80 56 64 42 C50 34 40 50 46 66Z" style="--len:110"/>
    <!-- inner core — espiral balanceado, centrado em x=60 -->
    <path d="M60 82 C50 76 48 64 58 58 C68 54 72 64 68 72 C64 80 60 78 60 70" style="--len:88"/>
    <path d="M60 70 C57 64 60 58 64 60" style="--len:28"/>
    <!-- broken halo above — perfeitamente centrado -->
    <path d="M33 26 C40 13 80 13 87 26" style="--len:82"/>
    <line x1="93" y1="22" x2="102" y2="20" style="--len:11"/>
    <line x1="27" y1="22" x2="18" y2="20" style="--len:11"/>
  </svg>
  <div class="rose-cap">a rosa azul · realizar o impossível</div>
</div>

<!-- ABOUT -->
<section class="about" id="about">
  <div class="about-grid">
    <div class="rv-l">
      <div class="pfp-wrap">
        <div class="pfp-halo"></div>
        <div class="pfp-glow"></div>
        <img src="data:image/jpeg;base64," alt="Ayato">
      </div>
      <div class="stats">
        <div class="chip"><strong>20</strong>anos</div>
        <div class="chip"><strong>∞</strong>autodidata</div>
        <div class="chip"><strong>Linux</strong>nativo</div>
      </div>
    </div>
    <div class="about-text rv-r">
      <div class="label">Sobre mim</div>
      <h2 class="title">Uma mente orientada a sistemas.</h2>
      <p>Estudante de segurança ofensiva em <strong>formação contínua</strong>. Sem certificação formal por enquanto — só projetos reais, ferramentas que escrevi do zero e a teimosia de entender <strong>como as coisas quebram</strong>.</p>
      <p>Construo o portfólio enquanto aprendo: de scanners de rede a um SIEM local, tudo funcional e documentado. A melhor forma de defender é pensar como quem ataca.</p>
      <p>Foco em bug bounty, pentest e segurança ofensiva como caminho profissional — explorando o mercado brasileiro de cyber com calma e estratégia de longo prazo.</p>
      <div class="tags">
        <span class="tag">nmap</span><span class="tag">sqlmap</span><span class="tag">nikto</span>
        <span class="tag">hydra</span><span class="tag">gobuster</span><span class="tag">burp suite</span>
        <span class="tag">python</span><span class="tag">bash</span><span class="tag">arch linux</span>
        <span class="tag">scapy</span><span class="tag">OSINT</span><span class="tag">flask</span>
      </div>
    </div>
  </div>
</section>

<div class="halo-sep"><div class="halo-ring"></div></div>

<!-- SKILLS -->
<section class="skills" id="skills">
  <div class="skills-bg"><img src="data:image/jpeg;base64," alt="" aria-hidden="true"></div>
  <div class="skills-inner">
    <div class="skills-head">
      <div class="label rv">Competências</div>
      <h2 class="title rv">Onde estou me aprimorando.</h2>
    </div>
    <div class="skills-grid">
      <div class="scard rv">
        <span class="sicon">🔍</span>
        <div class="sname">Reconhecimento</div>
        <p class="sdesc">OSINT, enumeração de alvos e footprinting ativo/passivo com nmap, gobuster e scapy.</p>
        <div class="smeta"><div class="sdots"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></div>sólido</div>
      </div>
      <div class="scard rv">
        <span class="sicon">💉</span>
        <div class="sname">Web Exploitation</div>
        <p class="sdesc">SQLi com sqlmap, XSS refletido e armazenado, interceptação e fuzzing com Burp Suite.</p>
        <div class="smeta"><div class="sdots"><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i></div>em evolução</div>
      </div>
      <div class="scard rv">
        <span class="sicon">🐍</span>
        <div class="sname">Scripting & Tools</div>
        <p class="sdesc">Automação em Python, TUIs com rich/curses e wrappers próprios de ferramentas de pentest.</p>
        <div class="smeta"><div class="sdots"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></div>sólido</div>
      </div>
      <div class="scard rv">
        <span class="sicon">🌐</span>
        <div class="sname">Redes & Protocolos</div>
        <p class="sdesc">Modelo OSI, TCP/UDP, DNS, manipulação de pacotes com hping3/scapy e análise de tráfego.</p>
        <div class="smeta"><div class="sdots"><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i></div>em evolução</div>
      </div>
      <div class="scard rv">
        <span class="sicon">🖥️</span>
        <div class="sname">Linux Avançado</div>
        <p class="sdesc">Arch / CachyOS no dia a dia, hardening, systemd, tuning de kernel e automação de ambiente.</p>
        <div class="smeta"><div class="sdots"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></div>sólido</div>
      </div>
      <div class="scard rv">
        <span class="sicon">📡</span>
        <div class="sname">Blue Team & SIEM</div>
        <p class="sdesc">SIEM local em Python, detecção de padrões em logs e análise de eventos no próprio lab.</p>
        <div class="smeta"><div class="sdots"><i class="on"></i><i class="on"></i><i></i><i></i><i></i></div>iniciando</div>
      </div>
    </div>
  </div>
</section>

<!-- BLUE ROSE small echo -->
<div class="halo-sep"><div class="halo-ring"></div></div>

<!-- PROJECTS -->
<section class="projects" id="projects">
  <div class="proj-head">
    <div class="label rv">Portfólio</div>
    <h2 class="title rv">Coisas que eu construí.</h2>
  </div>
  <div class="proj-list">
    <a class="pcard rv" href="https://github.com/ayatotenshipj-boop" target="_blank" rel="noopener">
      <div>
        <div class="pmeta"><span class="pnum">01</span><span class="ptag">Python / TUI</span></div>
        <div class="pname">CipherSec</div>
        <p class="pdesc">Painel de pentest modular no terminal. Integra nmap, sqlmap, nikto e hydra num TUI com box-drawing e navegação por teclado.</p>
        <div class="pstack"><span class="pill">python</span><span class="pill">curses</span><span class="pill">nmap</span><span class="pill">sqlmap</span><span class="pill">hydra</span></div>
      </div>
      <span class="parrow">→</span>
    </a>
    <a class="pcard rv" href="https://github.com/ayatotenshipj-boop" target="_blank" rel="noopener">
      <div>
        <div class="pmeta"><span class="pnum">02</span><span class="ptag">Flask / Security</span></div>
        <div class="pname">lab-siem</div>
        <p class="pdesc">Laboratório com webapp Flask deliberadamente vulnerável + monitor SIEM em terminal. Aprendo detectando ataques no meu próprio ambiente controlado.</p>
        <div class="pstack"><span class="pill">flask</span><span class="pill">python</span><span class="pill">rich</span><span class="pill">nikto</span></div>
      </div>
      <span class="parrow">→</span>
    </a>
    <a class="pcard rv" href="https://github.com/ayatotenshipj-boop" target="_blank" rel="noopener">
      <div>
        <div class="pmeta"><span class="pnum">03</span><span class="ptag">Python / Network</span></div>
        <div class="pname">horizon.py</div>
        <p class="pdesc">Toolkit de reconhecimento de rede no terminal. Wrapper de hping3 e scapy para teste de protocolos, com output formatado e navegação interativa.</p>
        <div class="pstack"><span class="pill">python</span><span class="pill">hping3</span><span class="pill">scapy</span><span class="pill">rich</span></div>
      </div>
      <span class="parrow">→</span>
    </a>
    <a class="pcard rv" href="https://github.com/ayatotenshipj-boop/Kairos" target="_blank" rel="noopener">
      <div>
        <div class="pmeta"><span class="pnum">04</span><span class="ptag">PySide6 / QML</span></div>
        <div class="pname">Kairos</div>
        <p class="pdesc">App de estudo desktop desenhado em torno do meu jeito de aprender. Recebe PDF, YouTube e áudio, processa com IA e organiza notas num vault Obsidian com mapa de conhecimento.</p>
        <div class="pstack"><span class="pill">pyside6</span><span class="pill">qml</span><span class="pill">obsidian</span><span class="pill">ollama</span></div>
      </div>
      <span class="parrow">→</span>
    </a>
  </div>
</section>

<div class="halo-sep"><div class="halo-ring"></div></div>

<!-- CONTACT -->
<section class="contact" id="contact">
  <div class="contact-inner">
    <div class="label rv">Contato</div>
    <h2 class="title rv">Vamos quebrar algo<br>— de forma responsável.</h2>
    <p class="contact-sub rv">Aberto a bug bounty, projetos de segurança e qualquer coisa que envolva entender sistemas a fundo.</p>
    <a href="https://discord.gg/wphm8zhj" class="btn btn-1 rv" target="_blank" rel="noopener"><span>Mandar mensagem no Discord</span></a>
    <div class="contact-links rv">
      <a class="clink" href="https://github.com/ayatotenshipj-boop" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
      <a class="clink" href="https://discord.gg/wphm8zhj" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.2 14.2 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.371-.291a.074.074 0 0 1 .078-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.245.198.372.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.331c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
